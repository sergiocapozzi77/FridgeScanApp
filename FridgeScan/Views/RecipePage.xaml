<ContentPage
    x:Class="FridgeScan.Views.RecipePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:button="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:chips="clr-namespace:Syncfusion.Maui.Toolkit.Chips;assembly=Syncfusion.Maui.Toolkit"
    xmlns:expander="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:sfBusy="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:viewmodel="clr-namespace:FridgeScan.ViewModels"
    xmlns:models="clr-namespace:FridgeScan.Models"
    xmlns:controls="clr-namespace:FridgeScan.Controls">

    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <Grid Padding="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label
                FontAttributes="Bold"
                FontSize="24"
                HorizontalOptions="Start"
                Text="Suggested Recipes"
                VerticalTextAlignment="Center" />
            <button:SfButton
                Grid.Column="1"
                Margin="1"
                Command="{Binding LoadSuggestionsCommand}"
                FontFamily="Material"
                FontSize="18"
                Text="Refresh" />
            <button:SfButton
                Grid.Column="2"
                Margin="1"
                Command="{Binding LoadAiSuggestionsCommand}"
                FontFamily="Material"
                FontSize="18"
                Text="wand_stars" />
        </Grid>

        <expander:SfExpander Grid.Row="1" Margin="10,0">
            <expander:SfExpander.Header>
                <Grid HeightRequest="40">
                    <Label
                        FontAttributes="Bold"
                        Text="Filters"
                        VerticalTextAlignment="Center" />
                </Grid>
            </expander:SfExpander.Header>
            <expander:SfExpander.Content>
                <VerticalStackLayout Padding="10">
                    <Label
                        Margin="0,5"
                        FontAttributes="Bold"
                        Text="Select Meal Type:" />

                    <chips:SfChipGroup
                        ChipType="Choice"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding MealTypes}"
                        SelectedItem="{Binding SelectedMealType, Mode=TwoWay}">

                        <chips:SfChipGroup.ChipLayout>
                            <FlexLayout
                                AlignContent="Start"
                                AlignItems="Start"
                                Direction="Row"
                                JustifyContent="Start"
                                Wrap="Wrap" />
                        </chips:SfChipGroup.ChipLayout>
                    </chips:SfChipGroup>

                    <BoxView
                        Margin="0,5"
                        HeightRequest="1"
                        Color="LightGray" />

                    <Label
                        Margin="0,0,0,20"
                        FontAttributes="Bold"
                        Text="Select Difficulty:" />
                    <chips:SfChipGroup
                        ChipType="Choice"
                        ChoiceMode="SingleOrNone"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding Difficulties}"
                        SelectedItem="{Binding SelectedDifficulty, Mode=TwoWay}">
                        <chips:SfChipGroup.ChipLayout>
                            <FlexLayout
                                AlignContent="Start"
                                Direction="Row"
                                JustifyContent="Start"
                                Wrap="Wrap" />
                        </chips:SfChipGroup.ChipLayout>
                    </chips:SfChipGroup>

                    <BoxView
                        Margin="0,5"
                        HeightRequest="1"
                        Color="LightGray" />

                    <Label
                        Margin="0,0,0,20"
                        FontAttributes="Bold"
                        Text="Total Time" />
                    <chips:SfChipGroup
                        ChipType="Choice"
                        ChoiceMode="SingleOrNone"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding TotalTimes}"
                        SelectedItem="{Binding SelectedTotalTime, Mode=TwoWay}">
                        <chips:SfChipGroup.ChipLayout>
                            <FlexLayout
                                AlignItems="Center"
                                Direction="Row"
                                JustifyContent="Start"
                                Wrap="Wrap" />
                        </chips:SfChipGroup.ChipLayout>
                    </chips:SfChipGroup>
                </VerticalStackLayout>
            </expander:SfExpander.Content>
        </expander:SfExpander>

        <expander:SfExpander Grid.Row="2" Margin="10,0,10,0">
            <expander:SfExpander.Header>
                <Grid HeightRequest="40">
                    <Label
                        FontAttributes="Bold"
                        Text="Ingredients"
                        VerticalTextAlignment="Center" />
                </Grid>
            </expander:SfExpander.Header>

            <expander:SfExpander.Content>
                <VerticalStackLayout Padding="10">

                    <Label
                        Margin="0,5"
                        FontAttributes="Bold"
                        Text="Select Ingredients:" />

                    <!--  Buttons Row  -->
                    <HorizontalStackLayout Margin="0,0,0,10" Spacing="10">

                        <button:SfButton
                            Command="{Binding SelectAllIngredientsCommand}"
                            CornerRadius="6"
                            HeightRequest="36"
                            Text="Select All"
                            WidthRequest="120" />

                        <button:SfButton
                            Command="{Binding DeselectAllIngredientsCommand}"
                            CornerRadius="6"
                            HeightRequest="36"
                            Text="Deselect All"
                            WidthRequest="120" />
                    </HorizontalStackLayout>

                    <!--  Chips  -->
                    <!--  Limit the visible height and allow scrolling when there are many chips  -->
                    <ScrollView
                        HeightRequest="250"
                        Orientation="Vertical"
                        VerticalScrollBarVisibility="Always">
                        <chips:SfChipGroup
                            ChipType="Filter"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding AvailableIngredients}"
                            SelectedItem="{Binding SelectedIngredients, Mode=TwoWay}">

                            <chips:SfChipGroup.ChipLayout>
                                <FlexLayout
                                    AlignItems="Start"
                                    Direction="Row"
                                    JustifyContent="Start"
                                    Wrap="Wrap" />
                            </chips:SfChipGroup.ChipLayout>

                        </chips:SfChipGroup>
                    </ScrollView>

                </VerticalStackLayout>
            </expander:SfExpander.Content>
        </expander:SfExpander>

        <expander:SfExpander Grid.Row="3" Margin="10,0,10,0">
            <expander:SfExpander.Header>
                <Grid HeightRequest="40">
                    <Label
                        FontAttributes="Bold"
                        Text="Keywords"
                        VerticalTextAlignment="Center" />
                </Grid>
            </expander:SfExpander.Header>

            <expander:SfExpander.Content>
                <VerticalStackLayout Padding="10">

                    <Label
                        Margin="0,5"
                        FontAttributes="Bold"
                        Text="Add Keywords:" />

                    <chips:SfChipGroup
                        x:Name="KeywordsEntry"
                        ChipType="Input"
                        ItemsSource="{Binding Keywords}">
                        <!--  This enables typing new keywords  -->
                        <chips:SfChipGroup.InputView>
                            <Entry
                                Completed="Entry_Completed"
                                FontSize="14"
                                Placeholder="Type a keyword and press Enter" />
                        </chips:SfChipGroup.InputView>

                        <chips:SfChipGroup.ChipLayout>
                            <FlexLayout
                                AlignItems="Start"
                                Direction="Row"
                                JustifyContent="Start"
                                Wrap="Wrap" />
                        </chips:SfChipGroup.ChipLayout>

                    </chips:SfChipGroup>

                </VerticalStackLayout>
            </expander:SfExpander.Content>
        </expander:SfExpander>

        <ScrollView Grid.Row="4">
            <VerticalStackLayout Padding="16" Spacing="16">
                <CollectionView
                    ItemsSource="{Binding Suggestions}"
                    SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}"
                    SelectionMode="None"
                    ItemsUpdatingScrollMode="KeepScrollOffset"
                    RemainingItemsThreshold="5">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <sf:SfCardView Margin="0,0,0,10" CornerRadius="6">
                                <sf:SfCardView.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:RecipeViewModel}}, Path=OpenRecipeCommand}" CommandParameter="{Binding}" />
                                </sf:SfCardView.GestureRecognizers>

                                <VerticalStackLayout Padding="2" Spacing="0">
                                    <Image
                                        Margin="0,0,0,4"
                                        Aspect="AspectFill"
                                        HeightRequest="140"
                                        Source="{Binding ImageUrl}" />

                                    <Label
                                        Margin="2,0,0,4"
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        LineBreakMode="CharacterWrap"
                                        MaxLines="1"
                                        Text="{Binding Name}" />

                                    <HorizontalStackLayout Margin="2,0,0,4" Spacing="12">
                                        <Label
                                            FontSize="14"
                                            Text="{Binding PrepTime, StringFormat='{0} minutes'}"
                                            TextColor="Gray" />
                                        <Label
                                            FontSize="14"
                                            Text="{Binding Difficulty}"
                                            TextColor="Gray" />
                                        <Label
                                            FontSize="14"
                                            Text="{Binding RecipeSource}"
                                            TextColor="Gray" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </sf:SfCardView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <sfBusy:SfBusyIndicator
            Title="Loading recipes..."
            Grid.Row="4"
            AnimationType="CircularMaterial"
            BackgroundColor="#80000000"
            HeightRequest="90"
            HorizontalOptions="Center"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            VerticalOptions="Center"
            WidthRequest="120" />
        </Grid>

        <!-- Floating Bottom Bar -->
        <controls:FloatingBottomBar Grid.Row="1" />
    </Grid>
</ContentPage>