<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FridgeScan.Views.BarcodeScannerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:barcode="clr-namespace:BarcodeScanning;assembly=BarcodeScanning.Native.Maui"
    xmlns:sfCal="clr-namespace:Syncfusion.Maui.Calendar;assembly=Syncfusion.Maui.Calendar"
    BackgroundColor="#0D0D2B"
    Title="Barcode Scanner"
    Shell.PresentationMode="ModalAnimated">

    <Grid>
        <!-- Layer 1: Camera feed -->
        <barcode:CameraView
            x:Name="Barcode"
            AimMode="True"
            BarcodeSymbologies="All"
            CaptureQuality="High"
            OnDetectionFinished="CameraView_OnDetectionFinished"
            TapToFocusEnabled="True" />

        <!-- Layer 2: Barcode detection bounding boxes -->
        <GraphicsView
            x:Name="Graphics"
            InputTransparent="True" />

        <!-- Layer 3: Scrim overlay with center cutout -->
        <Grid InputTransparent="True">
            <Grid RowDefinitions="*,1.5*,*" ColumnDefinitions="*,4*,*">
                <!-- Top bar -->
                <BoxView Grid.ColumnSpan="3" BackgroundColor="#8C000000" />
                <!-- Bottom bar -->
                <BoxView Grid.Row="2" Grid.ColumnSpan="3" BackgroundColor="#8C000000" />
                <!-- Left bar -->
                <BoxView Grid.Row="1" BackgroundColor="#8C000000" />
                <!-- Right bar -->
                <BoxView Grid.Row="1" Grid.Column="2" BackgroundColor="#8C000000" />

                <!-- Center cell: transparent cutout + corner markers -->
                <Grid Grid.Row="1" Grid.Column="1">
                    <!-- Top-left L -->
                    <BoxView WidthRequest="24" HeightRequest="3" BackgroundColor="#B3FFFFFF" HorizontalOptions="Start" VerticalOptions="Start" />
                    <BoxView WidthRequest="3" HeightRequest="24" BackgroundColor="#B3FFFFFF" HorizontalOptions="Start" VerticalOptions="Start" />
                    <!-- Top-right L -->
                    <BoxView WidthRequest="24" HeightRequest="3" BackgroundColor="#B3FFFFFF" HorizontalOptions="End" VerticalOptions="Start" />
                    <BoxView WidthRequest="3" HeightRequest="24" BackgroundColor="#B3FFFFFF" HorizontalOptions="End" VerticalOptions="Start" />
                    <!-- Bottom-left L -->
                    <BoxView WidthRequest="24" HeightRequest="3" BackgroundColor="#B3FFFFFF" HorizontalOptions="Start" VerticalOptions="End" />
                    <BoxView WidthRequest="3" HeightRequest="24" BackgroundColor="#B3FFFFFF" HorizontalOptions="Start" VerticalOptions="End" />
                    <!-- Bottom-right L -->
                    <BoxView WidthRequest="24" HeightRequest="3" BackgroundColor="#B3FFFFFF" HorizontalOptions="End" VerticalOptions="End" />
                    <BoxView WidthRequest="3" HeightRequest="24" BackgroundColor="#B3FFFFFF" HorizontalOptions="End" VerticalOptions="End" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Layer 4: Back button — 40dp circle Border, matches flip/torch style -->
        <Border BackgroundColor="#1E1E3A"
                StrokeShape="RoundRectangle 20"
                Stroke="Transparent"
                WidthRequest="40"
                HeightRequest="40"
                Margin="10,12,0,0"
                VerticalOptions="Start"
                HorizontalOptions="Start">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackClicked" />
            </Border.GestureRecognizers>
            <Label Text="&#xe5c4;"
                   FontFamily="Material"
                   FontSize="18"
                   TextColor="#CCCCDD"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Border>

        <!-- Layer 4: Camera toolbar (flip + torch) — 40dp circle Borders -->
        <HorizontalStackLayout HorizontalOptions="End"
                               VerticalOptions="Start"
                               Spacing="8"
                               Margin="0,12,16,0">
            <Border BackgroundColor="#1E1E3A"
                    StrokeShape="RoundRectangle 20"
                    Stroke="Transparent"
                    WidthRequest="40"
                    HeightRequest="40">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFlipCameraClicked" />
                </Border.GestureRecognizers>
                <Label Text="&#xe412;"
                       FontFamily="Material"
                       FontSize="18"
                       TextColor="#CCCCDD"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
            <Border BackgroundColor="#1E1E3A"
                    StrokeShape="RoundRectangle 20"
                    Stroke="Transparent"
                    WidthRequest="40"
                    HeightRequest="40">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTorchClicked" />
                </Border.GestureRecognizers>
                <Label Text="&#xe42b;"
                       FontFamily="Material"
                       FontSize="18"
                       TextColor="#CCCCDD"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
        </HorizontalStackLayout>

        <!-- Layer 5: Product panel with expiry calendar — full-screen overlay -->
        <Border x:Name="ProductPanel"
                BackgroundColor="#0D0D2B"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                IsVisible="False"
                Opacity="0"
                Padding="0">
            <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="20,0,20,24">

                <!-- Product header: image + name + instruction -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="Auto,*"
                      Padding="0,56,0,0"
                      Margin="0,0,0,4">
                    <Border Grid.Column="0"
                            WidthRequest="56"
                            HeightRequest="56"
                            StrokeShape="RoundRectangle 12"
                            Stroke="Transparent"
                            BackgroundColor="#14142E"
                            Padding="0">
                        <Image x:Name="ProductImage"
                               Aspect="AspectFit"
                               WidthRequest="56"
                               HeightRequest="56" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1"
                                         VerticalOptions="Center"
                                         Margin="14,0,0,0"
                                         Spacing="2">
                        <Label x:Name="ProductName"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="White"
                               MaxLines="1"
                               LineBreakMode="TailTruncation" />
                        <Label Text="Tap a date to set expiry"
                               FontSize="13"
                               TextColor="#8888AA" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Section title -->
                <Label Grid.Row="1"
                       Text="Expiry date"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#CCCCDD"
                       Margin="0,0,0,8" />

                <!-- Calendar month view -->
                <sfCal:SfCalendar Grid.Row="2"
                                  x:Name="ExpiryCalendar"
                                  SelectionChanged="OnExpiryDateSelected"
                                  SelectionMode="Single"
                                  CornerRadius="16"
                                  Margin="0,0,0,8" />

                <!-- Bottom buttons -->
                <HorizontalStackLayout Grid.Row="3"
                                       Spacing="12"
                                       HorizontalOptions="Center"
                                       Margin="0,8,0,0">
                    <!-- Save without expiry -->
                    <Border BackgroundColor="#1E1E3A"
                            StrokeShape="RoundRectangle 20"
                            Stroke="Transparent"
                            HeightRequest="44"
                            Padding="20,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSaveWithoutExpiryClicked" />
                        </Border.GestureRecognizers>
                        <Label Text="Save without expiry"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#CCCCDD"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
                    </Border>
                    <!-- Cancel -->
                    <Border BackgroundColor="#2A1E1E"
                            StrokeShape="RoundRectangle 20"
                            Stroke="Transparent"
                            HeightRequest="44"
                            Padding="20,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCancelClicked" />
                        </Border.GestureRecognizers>
                        <Label Text="Cancel"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#ff6b6b"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
