<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FridgeScan.Views.CookbookDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sfPull="clr-namespace:Syncfusion.Maui.PullToRefresh;assembly=Syncfusion.Maui.PullToRefresh"
    xmlns:shimmer="clr-namespace:Syncfusion.Maui.Shimmer;assembly=Syncfusion.Maui.Core"
    xmlns:converters="clr-namespace:FridgeScan.Converters"
    xmlns:models="clr-namespace:FridgeScan.Models"
    xmlns:viewmodel="clr-namespace:FridgeScan.ViewModels"
    BackgroundColor="#0D0D2B"
    Shell.PresentationMode="Animated"
    Title="{Binding Cookbook.Name}">

    <ContentPage.Resources>
        <converters:IsStringNotNullOrEmptyConverter x:Key="IsNotNullConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Padding="20,16,16,16" Spacing="2">

            <!-- Row 1: back arrow + title + action icons -->
            <Grid ColumnDefinitions="36,*,Auto,Auto">

                <!-- Back arrow: Material ArrowBack, 48dp transparent touch target -->
                <Label Grid.Column="0"
                       Text="&#xe5c4;"
                       FontFamily="Material"
                       FontSize="24"
                       TextColor="#CCCCDD"
                       WidthRequest="48"
                       HeightRequest="48"
                       Margin="-12,0,0,0"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- Title -->
                <Label Grid.Column="1"
                       Text="{Binding Cookbook.Name}"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"
                       VerticalOptions="Center" />

                <!-- Edit / Rename icon -->
                <Border Grid.Column="2"
                        IsVisible="{Binding HasActions}"
                        BackgroundColor="#1E1E3A"
                        StrokeShape="RoundRectangle 20"
                        Stroke="Transparent"
                        WidthRequest="40"
                        HeightRequest="40"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RenameCookbookCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="&#xe3c9;"
                           FontFamily="Material"
                           FontSize="18"
                           TextColor="#CCCCDD"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Delete icon -->
                <Border Grid.Column="3"
                        IsVisible="{Binding HasActions}"
                        BackgroundColor="#2A1E1E"
                        StrokeShape="RoundRectangle 20"
                        Stroke="Transparent"
                        WidthRequest="40"
                        HeightRequest="40"
                        Margin="4,0,0,0"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DeleteCookbookCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="&#xe872;"
                           FontFamily="Material"
                           FontSize="16"
                           TextColor="#ff6b6b"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Row 2: recipe count, indented to align with title -->
            <Label Margin="36,0,0,0" FontSize="13" TextColor="#8888AA">
                <Label.Text>
                    <MultiBinding StringFormat="{}{0} recipes">
                        <Binding Path="Cookbook.RecipeCount" />
                    </MultiBinding>
                </Label.Text>
            </Label>
        </VerticalStackLayout>

        <!-- Recipe list with shimmer -->
        <shimmer:SfShimmer Grid.Row="1"
                           IsActive="{Binding IsLoading}"
                           Fill="#0D0D2B"
                           WaveColor="#252555"
                           BackgroundColor="#0D0D2B">
            <shimmer:SfShimmer.CustomView>
                <VerticalStackLayout Padding="12,0" Spacing="8">
                    <!-- Skeleton card 1 -->
                    <Border Padding="0"
                            BackgroundColor="Transparent"
                            StrokeShape="RoundRectangle 12"
                            Stroke="Transparent"
                            HeightRequest="100">
                        <Grid ColumnDefinitions="130,*" HeightRequest="100">
                            <BoxView Grid.Column="0"
                                     HeightRequest="100"
                                     WidthRequest="130"
                                     Color="#1E1E3A"
                                     CornerRadius="12,0,0,12" />
                            <VerticalStackLayout Grid.Column="1"
                                                  Padding="12,8"
                                                  Spacing="6"
                                                  VerticalOptions="Center">
                                <BoxView HeightRequest="14"
                                         WidthRequest="180"
                                         Color="#1E1E3A"
                                         CornerRadius="4"
                                         HorizontalOptions="Start" />
                                <BoxView HeightRequest="10"
                                         WidthRequest="120"
                                         Color="#1E1E3A"
                                         CornerRadius="4"
                                         HorizontalOptions="Start" />
                                <HorizontalStackLayout Spacing="6" Margin="0,4,0,0">
                                    <BoxView HeightRequest="22"
                                             WidthRequest="60"
                                             Color="#1E1E3A"
                                             CornerRadius="10" />
                                    <BoxView HeightRequest="22"
                                             WidthRequest="50"
                                             Color="#1E1E3A"
                                             CornerRadius="10" />
                                    <BoxView HeightRequest="22"
                                             WidthRequest="55"
                                             Color="#1E1E3A"
                                             CornerRadius="10" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <!-- Skeleton card 2 -->
                    <Border Padding="0"
                            BackgroundColor="Transparent"
                            StrokeShape="RoundRectangle 12"
                            Stroke="Transparent"
                            HeightRequest="100">
                        <Grid ColumnDefinitions="130,*" HeightRequest="100">
                            <BoxView Grid.Column="0"
                                     HeightRequest="100"
                                     WidthRequest="130"
                                     Color="#1E1E3A"
                                     CornerRadius="12,0,0,12" />
                            <VerticalStackLayout Grid.Column="1"
                                                  Padding="12,8"
                                                  Spacing="6"
                                                  VerticalOptions="Center">
                                <BoxView HeightRequest="14"
                                         WidthRequest="160"
                                         Color="#1E1E3A"
                                         CornerRadius="4"
                                         HorizontalOptions="Start" />
                                <BoxView HeightRequest="10"
                                         WidthRequest="140"
                                         Color="#1E1E3A"
                                         CornerRadius="4"
                                         HorizontalOptions="Start" />
                                <HorizontalStackLayout Spacing="6" Margin="0,4,0,0">
                                    <BoxView HeightRequest="22"
                                             WidthRequest="70"
                                             Color="#1E1E3A"
                                             CornerRadius="10" />
                                    <BoxView HeightRequest="22"
                                             WidthRequest="45"
                                             Color="#1E1E3A"
                                             CornerRadius="10" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <!-- Skeleton card 3 -->
                    <Border Padding="0"
                            BackgroundColor="Transparent"
                            StrokeShape="RoundRectangle 12"
                            Stroke="Transparent"
                            HeightRequest="100">
                        <Grid ColumnDefinitions="130,*" HeightRequest="100">
                            <BoxView Grid.Column="0"
                                     HeightRequest="100"
                                     WidthRequest="130"
                                     Color="#1E1E3A"
                                     CornerRadius="12,0,0,12" />
                            <VerticalStackLayout Grid.Column="1"
                                                  Padding="12,8"
                                                  Spacing="6"
                                                  VerticalOptions="Center">
                                <BoxView HeightRequest="14"
                                         WidthRequest="200"
                                         Color="#1E1E3A"
                                         CornerRadius="4"
                                         HorizontalOptions="Start" />
                                <BoxView HeightRequest="10"
                                         WidthRequest="100"
                                         Color="#1E1E3A"
                                         CornerRadius="4"
                                         HorizontalOptions="Start" />
                                <HorizontalStackLayout Spacing="6" Margin="0,4,0,0">
                                    <BoxView HeightRequest="22"
                                             WidthRequest="55"
                                             Color="#1E1E3A"
                                             CornerRadius="10" />
                                    <BoxView HeightRequest="22"
                                             WidthRequest="65"
                                             Color="#1E1E3A"
                                             CornerRadius="10" />
                                    <BoxView HeightRequest="22"
                                             WidthRequest="50"
                                             Color="#1E1E3A"
                                             CornerRadius="10" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <!-- Skeleton card 4 -->
                    <Border Padding="0"
                            BackgroundColor="Transparent"
                            StrokeShape="RoundRectangle 12"
                            Stroke="Transparent"
                            HeightRequest="100">
                        <Grid ColumnDefinitions="130,*" HeightRequest="100">
                            <BoxView Grid.Column="0"
                                     HeightRequest="100"
                                     WidthRequest="130"
                                     Color="#1E1E3A"
                                     CornerRadius="12,0,0,12" />
                            <VerticalStackLayout Grid.Column="1"
                                                  Padding="12,8"
                                                  Spacing="6"
                                                  VerticalOptions="Center">
                                <BoxView HeightRequest="14"
                                         WidthRequest="150"
                                         Color="#1E1E3A"
                                         CornerRadius="4"
                                         HorizontalOptions="Start" />
                                <BoxView HeightRequest="10"
                                         WidthRequest="130"
                                         Color="#1E1E3A"
                                         CornerRadius="4"
                                         HorizontalOptions="Start" />
                                <HorizontalStackLayout Spacing="6" Margin="0,4,0,0">
                                    <BoxView HeightRequest="22"
                                             WidthRequest="50"
                                             Color="#1E1E3A"
                                             CornerRadius="10" />
                                    <BoxView HeightRequest="22"
                                             WidthRequest="60"
                                             Color="#1E1E3A"
                                             CornerRadius="10" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </shimmer:SfShimmer.CustomView>

            <sfPull:SfPullToRefresh IsRefreshing="{Binding IsLoading}"
                                     RefreshCommand="{Binding LoadRecipesCommand}"
                                     BackgroundColor="#0D0D2B">
                <sfPull:SfPullToRefresh.PullableContent>
                    <CollectionView ItemsSource="{Binding Recipes}"
                                    SelectionMode="Single"
                                    SelectionChanged="OnRecipeSelected"
                                    Margin="12,0"
                                    BackgroundColor="#0D0D2B">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:SavedRecipe">
                                <Border Margin="8,4"
                                        Padding="0"
                                        BackgroundColor="#161638"
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="#14FFFFFF"
                                        StrokeThickness="1">
                                    <Grid ColumnDefinitions="130,*" HeightRequest="100">
                                        <Image Grid.Column="0"
                                               Source="{Binding ImageUrl}"
                                               Aspect="AspectFill"
                                               WidthRequest="130"
                                               HeightRequest="100" />
                                        <Grid Grid.Column="1"
                                              ColumnDefinitions="*,Auto"
                                              Padding="12, 4">
                                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding Name}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="White"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="2" />
                                                <Label Text="{Binding RecipeSource}"
                                                       FontSize="12"
                                                       TextColor="#777" />
                                                <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                                                    <Border BackgroundColor="#3A3420"
                                                            StrokeShape="RoundRectangle 10"
                                                            Stroke="Transparent"
                                                            Padding="10,0"
                                                            HeightRequest="22"
                                                            IsVisible="{Binding TotalTime, Converter={StaticResource IsNotNullConverter}}">
                                                        <Label Text="{Binding TotalTime}"
                                                               FontSize="10"
                                                               TextColor="#E8C86A"
                                                               VerticalOptions="Center" />
                                                    </Border>
                                                    <Border BackgroundColor="#1E3A2E"
                                                            StrokeShape="RoundRectangle 10"
                                                            Stroke="Transparent"
                                                            Padding="10,0"
                                                            HeightRequest="22"
                                                            IsVisible="{Binding Difficulty, Converter={StaticResource IsNotNullConverter}}">
                                                        <Label Text="{Binding Difficulty}"
                                                               FontSize="10"
                                                               TextColor="#81C784"
                                                               VerticalOptions="Center" />
                                                    </Border>
                                                    <Border BackgroundColor="#2A1E3A"
                                                            StrokeShape="RoundRectangle 10"
                                                            Stroke="Transparent"
                                                            Padding="10,0"
                                                            HeightRequest="22"
                                                            IsVisible="{Binding Serving, Converter={StaticResource IsNotNullConverter}}">
                                                        <Label Text="{Binding Serving}"
                                                               FontSize="10"
                                                               TextColor="#CE93D8"
                                                               VerticalOptions="Center" />
                                                    </Border>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="&#x22ef;"
                                                   FontSize="20"
                                                   TextColor="#666"
                                                   VerticalOptions="Center"
                                                   Padding="8,0">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:CookbookDetailViewModel}}, Path=EditRecipeCommand}"
                                                        CommandParameter="{Binding}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center"
                                                 VerticalOptions="Center"
                                                 Padding="0,60"
                                                 Spacing="8">
                                <Label Text="No recipes yet"
                                       FontSize="16"
                                       TextColor="#8888AA"
                                       HorizontalOptions="Center" />
                                <Label Text="Import a recipe to get started"
                                       FontSize="13"
                                       TextColor="#8888AA"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </sfPull:SfPullToRefresh.PullableContent>
            </sfPull:SfPullToRefresh>
        </shimmer:SfShimmer>
    </Grid>
</ContentPage>
